{
  "version": "1.2.0",
  "app_name": "Lottery Alert System Pro",
  "sources": {
    "pholhuay": {
      "enabled": false,
      "name": "ผลหวย (Pholhuay)",
      "url": "https://api.pholhuay.com/v1/lottery/latest",
      "timeout_sec": 10,
      "priority": 1
    },
    "glo": {
      "enabled": true,
      "name": "สำนักงานสลากกินแบ่งรัฐบาล (GLO Official)",
      "url": "https://www.glo.or.th/api/lottery/getLatestLottery",
      "timeout_sec": 12,
      "priority": 5
    },
    "sanook": {
      "enabled": false,
      "name": "Sanook Lottery",
      "url": "https://news.sanook.com/lotto/api/latest",
      "timeout_sec": 10,
      "priority": 3
    },
    "ranlotto": {
      "enabled": true,
      "name": "RANLOTTO public API (Thai government results fallback)",
      "url": "https://api.ranlotto.com/api/public/v1/lottery/result/latest",
      "timeout_sec": 10,
      "priority": 7
    },
    "lotterychecks": {
      "enabled": true,
      "name": "LotteryChecks public results API (Thai government fallback)",
      "url": "https://lotterychecks.com/api/public/results?lottery=thai-government&limit=1",
      "timeout_sec": 10,
      "priority": 6,
      "attribution": "https://lotterychecks.com"
    },
    "thailottoapi": {
      "enabled": true,
      "name": "ThaiLottoAPI stock/VIP results and schedules",
      "url": "https://thailottoapi.com/api/results",
      "schedules_url": "https://thailottoapi.com/api/schedules?category=stock",
      "timeout_sec": 12,
      "priority": 1,
      "category": "stock",
      "timezone": "Asia/Bangkok",
      "attribution": "https://thailottoapi.com"
    }
  },
  "notifications": {
    "enabled": true,
    "notify_on_new_draw": true,
    "notify_on_prize_match": true,
    "notify_prizes": {
      "top3": true,
      "bottom2": true
    },
    "custom_watched_numbers": [
      "95",
      "42",
      "84",
      "19",
      "56",
      "289594"
    ],
    "cooldown_minutes": 15,
    "max_retries": 3
  },
  "channels": {
    "ntfy": {
      "enabled": true,
      "server": "https://ntfy.sh",
      "topic": "lottery-alert-live",
      "priority": "high",
      "tags": [
        "moneybag",
        "dart",
        "loudspeaker"
      ],
      "click_url": "https://bombim00.pages.dev"
    }
  },
  "ntfy": {
    "server": "https://ntfy.sh",
    "default_priority": "high",
    "tags": [
      "moneybag",
      "dart",
      "loudspeaker"
    ],
    "click_url": "https://bombim00.pages.dev",
    "attach_results": true,
    "enabled": true,
    "topic": "lottery-alert-live"
  },
  "schedule": {
    "cron": "*/5 * * * *",
    "timezone": "Asia/Bangkok",
    "description": "ตรวจสอบผลหวยอัตโนมัติทุก 5 นาทีตลอดวัน ผ่าน GitHub Actions"
  },
  "message_template": {
    "preset": "standard",
    "title": "📢 ผล{lottery_name} งวด {draw_date}",
    "body": "{lottery_name}\n{top3} - {bottom2}",
    "speech_script": "ประกาศผล {lottery_name} สามตัวบน {first_prize_spelled} สองตัวล่าง {last_2_spelled} {polite_ending}.",
    "polite_particle": "ครับ",
    "font_family": "sans",
    "font_size": "large",
    "modal_theme": "gold",
    "number_display_style": "spacious",
    "include_emojis": true,
    "include_next_closing": false
  }
}